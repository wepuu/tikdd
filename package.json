{
  "name": "tikdd",
  "version": "0.1.0",
  "private": true,
  "description": "A multilingual, provider-agnostic public media resolver.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/local-stack.mjs start offline",
    "dev:pilot": "node scripts/local-stack.mjs start pilot",
    "dev:stop": "node scripts/local-stack.mjs stop",
    "dev:services": "pnpm --parallel --filter @tikdd/web --filter @tikdd/api --filter @tikdd/worker --filter @tikdd/delivery dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:work-item-10:contracts": "vitest run packages/providers/test/site-adapters.test.ts packages/providers/test/x-routing-contract.test.ts packages/providers/test/provider-router.test.ts packages/delivery-core/test/delivery-core.test.ts apps/delivery/test/app.test.ts apps/worker/test/provider-activation.test.ts apps/worker/test/rollout.test.ts packages/rollout-control/test/pilot-guard.test.ts packages/platform/test/detect-platform.test.ts apps/api/test/public-task.test.ts apps/web/test/task-presentation.test.ts apps/web/test/result-presentation.test.ts apps/canary/test/configuration.test.ts apps/canary/test/runtime-config.test.ts packages/contracts/test/task-admission-openapi.test.ts",
    "test:work-item-11-1": "vitest run scripts/local-stack-core.test.mjs",
    "smoke:local": "node scripts/smoke.mjs",
    "canary:providers": "pnpm --filter @tikdd/providers canary",
    "canary:start": "pnpm --filter @tikdd/canary start",
    "canary:run": "pnpm --filter @tikdd/canary execute",
    "verify:canary": "pnpm --filter @tikdd/canary verify",
    "rollout:apply": "pnpm --filter @tikdd/worker rollout:apply",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docker:version": "node scripts/docker.mjs version",
    "infra:up": "node scripts/docker.mjs compose up -d postgres redis",
    "infra:status": "node scripts/docker.mjs compose ps",
    "infra:down": "node scripts/docker.mjs compose down",
    "db:migrate": "pnpm --filter @tikdd/persistence db:migrate",
    "db:verify-delivery-transaction": "pnpm --filter @tikdd/persistence db:verify-delivery-transaction",
    "db:verify-provider-attempt-region": "pnpm --filter @tikdd/persistence db:verify-provider-attempt-region",
    "db:verify-task-admission": "pnpm --filter @tikdd/persistence db:verify-task-admission",
    "cleanup:start": "pnpm --filter @tikdd/cleanup start",
    "cleanup:run": "pnpm --filter @tikdd/cleanup execute",
    "cleanup:dry-run": "pnpm --filter @tikdd/cleanup dry-run",
    "evidence:start": "pnpm --filter @tikdd/evidence start",
    "evidence:run": "pnpm --filter @tikdd/evidence execute",
    "verify:evidence": "pnpm --filter @tikdd/evidence verify",
    "preflight:internal": "pnpm --filter @tikdd/preflight start",
    "verify:preflight": "pnpm --filter @tikdd/preflight verify",
    "verify:work-item-11:residue": "pnpm --filter @tikdd/evidence verify:residue",
    "verify:cleanup": "pnpm --filter @tikdd/cleanup verify",
    "verify:routing-health": "pnpm --filter @tikdd/worker verify:routing-health",
    "verify:rollout-control": "pnpm --filter @tikdd/worker verify:rollout-control",
    "verify:pilot-control": "pnpm --filter @tikdd/worker verify:pilot-control",
    "verify:work-item-10:residue": "pnpm --filter @tikdd/worker verify:work-item-10-residue",
    "verify:admission-control": "pnpm --filter @tikdd/admission-control verify:redis",
    "verify:work-item-9": "node scripts/verify-work-item-9.mjs",
    "verify:work-item-10:evidence": "node scripts/verify-work-item-10-evidence.mjs",
    "verify:work-item-10": "node scripts/verify-work-item-10.mjs",
    "test:work-item-11": "vitest run packages/rollout-control/test/pilot-evidence.test.ts packages/rollout-control/test/pilot-guard.test.ts packages/persistence/test/pilot-evidence-migration.test.ts apps/evidence/test/configuration.test.ts apps/api/test/pilot-evidence-diagnostics.test.ts apps/delivery/test/app.test.ts apps/cleanup/test/runner.test.ts",
    "verify:work-item-11": "node scripts/verify-work-item-11.mjs",
    "test:work-item-11-5": "vitest run packages/deployment-preflight/test/preflight.test.ts packages/rollout-control/test/rollout-control.test.ts packages/rollout-control/test/pilot-guard.test.ts apps/worker/test/rollout.test.ts apps/worker/test/provider-activation.test.ts apps/delivery/test/app.test.ts apps/cleanup/test/runner.test.ts scripts/local-stack-core.test.mjs",
    "verify:work-item-11-5": "node scripts/verify-work-item-11-5.mjs",
    "verify:work-item-11-baseline": "node scripts/verify-work-item-11-baseline.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
