NODE_ENV=development
# Internal observation is fail-closed and requires a fresh signed preflight attestation shared by
# API and Worker. Keep this public/local until deployment settings and Provider-use confirmation are complete.
TIKDD_DEPLOYMENT_STAGE=local
TIKDD_DEPLOYMENT_ID=
TIKDD_OBSERVATION_CLASS=public
TIKDD_INTERNAL_PREFLIGHT_PLAN_PATH=config/x-internal-preflight.json
TIKDD_INTERNAL_PREFLIGHT_SIGNALS_JSON=
TIKDD_INTERNAL_PREFLIGHT_HMAC_KEY_BASE64URL=
TIKDD_INTERNAL_PREFLIGHT_ATTESTATION_OUTPUT=
TIKDD_INTERNAL_PREFLIGHT_ATTESTATION=
WEB_ORIGIN=http://localhost:3000
# Read-only public content identity. Production should use a separate database user with SELECT only
# on published snapshot heads/snapshots, not the Admin/editorial tables.
PUBLIC_CONTENT_DATABASE_URL=postgresql://tikdd:tikdd@localhost:5432/tikdd
PUBLIC_CONTENT_DEPLOYMENT_ID=tikdd
PUBLIC_CONTENT_STALE_AFTER_MS=900000
PUBLIC_CONTENT_REVALIDATION_SECRET=
PUBLIC_CONTENT_REVALIDATION_TIMEOUT_MS=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DELIVERY_BASE_URL=http://localhost:4002
API_PORT=4000
DELIVERY_PORT=4002
DELIVERY_PUBLIC_BASE_URL=http://localhost:4002
DATABASE_URL=postgresql://tikdd:tikdd@localhost:5432/tikdd
# Docker Desktop/Hyper-V may reserve the traditional Redis port on Windows.
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379
# Private owner API. Authentication uses one TikDD password account in PostgreSQL plus Redis sessions.
ADMIN_API_PORT=4100
ADMIN_API_HOST=127.0.0.1
ADMIN_AUTH_MODE=password
ADMIN_ORIGIN=http://localhost:3001
ADMIN_API_INTERNAL_ORIGIN=http://127.0.0.1:4100
ADMIN_API_FETCH_TIMEOUT_MS=5000
ADMIN_REFRESH_INTERVAL_MS=30000
ADMIN_COMMAND_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_ROUTE_POLICY_TTL_MS=60000
ADMIN_DEPLOYMENT_ID=local
ADMIN_REGION=nl
ADMIN_READ_TIMEOUT_MS=2000
ADMIN_FRESHNESS_MS=300000
ADMIN_CSRF_SECRET=
# Shared only by Nginx and Admin API; it proves traffic crossed the reviewed origin boundary.
ADMIN_ORIGIN_PROOF=
TIKDD_ADMIN_BUILD_ID=
# Read-only deployment markers for the owner console. They do not contain credentials.
CLOUDFLARE_TUNNEL_CONFIGURED=false
NGINX_ADMIN_PROXY_CONFIGURED=false
# `pnpm dev:pilot` reads these values only from the current shell, never from this file.
# Keep them unset here so technical-test authorization cannot become a persistent default.
TIKDD_LOCAL_LIVE_AUTHORIZED=false
TIKDD_PILOT_PROVIDERS=
TIKDD_PILOT_PROXY_URL=
TASK_TTL_HOURS=24
# Independent bounded cleanup service. Production requires an explicit deployment namespace.
CLEANUP_DEPLOYMENT=local
CLEANUP_INTERVAL_MS=60000
CLEANUP_BATCH_SIZE=100
CLEANUP_TIME_BUDGET_MS=5000
CLEANUP_MAX_BATCHES=24
CLEANUP_STATEMENT_TIMEOUT_MS=2000
CLEANUP_LEASE_TTL_MS=15000
TASK_HARD_RETENTION_MS=86400000
# Required in production. Use a different random key from rollout and delivery secrets.
TASK_ADMISSION_HMAC_KEY_BASE64URL=
ACTIVE_SOURCE_TTL_MS=300000
# Production cannot disable this boundary. With no trusted proxy CIDRs, forwarded headers are
# ignored and the socket peer becomes the anonymous quota identity.
ADMISSION_CONTROL_ENABLED=false
TRUSTED_PROXY_CIDRS=
ADMISSION_CONTROL_POLICY_JSON={"version":"pilot-v1","deployment":"local","region":"global","requestWindowMs":60000,"clientRequestLimit":30,"globalRequestLimit":1000,"clientActiveTaskLimit":3,"globalActiveTaskLimit":100,"taskPermitTtlMs":1800000,"providerDefaultConcurrency":2,"providerLeaseTtlMs":45000,"providerLimits":[]}
ENABLE_MOCK_PROVIDER=true
# Site adapters stay disabled by default. Live tests also require the documented authorization gate.
ENABLE_TWITTERSAVER_PROVIDER=false
ENABLE_DLPANDA_PROVIDER=false
ENABLE_SSSTWITTER_PROVIDER=false
TWITTERSAVER_TERMS_APPROVED=false
DLPANDA_TERMS_APPROVED=false
SSSTWITTER_TERMS_APPROVED=false
# Set only after the bounded live media HEAD/redirect/MIME/lifetime review is recorded.
SSSTWITTER_DELIVERY_AUDIT_APPROVED=false
# Required before a provider may persist delivery candidates. Use a unique 32-byte base64url key.
DELIVERY_ENCRYPTION_KEY_ID=
DELIVERY_ENCRYPTION_KEY_BASE64URL=
WORKER_REGION=global
ROUTE_MAX_ATTEMPTS=4
ROUTE_TIMEOUT_MS=30000
# Production providers require a current affirmative rollout rule. The development bypass is never
# accepted in production. Use a unique random key with at least 32 bytes when rollout is enabled.
PROVIDER_ROLLOUT_ENABLED=false
PROVIDER_ROLLOUT_DEVELOPMENT_BYPASS=false
PROVIDER_ROLLOUT_COHORT_KEY_BASE64URL=
PROVIDER_ROLLOUT_REFRESH_MS=5000
PROVIDER_ROLLOUT_SNAPSHOT_TTL_MS=30000
PROVIDER_ROLLOUT_MAX_STALE_MS=15000
PROVIDER_PILOT_GUARD_REQUIRED=false
# Dynamic health is opt-in. When enabled, provide a reviewed versioned policy JSON document.
PROVIDER_HEALTH_ENABLED=false
PROVIDER_HEALTH_POLICY_JSON=
PROVIDER_HEALTH_REFRESH_MS=10000
# Optional independent credential for the metadata-only internal diagnostics route.
PROVIDER_DIAGNOSTICS_TOKEN=
# Independent five-minute UTC evidence projection and restrictive evaluator. This service grants
# no traffic; production requires explicit deployment and opaque owner identities.
EVIDENCE_DEPLOYMENT=local
EVIDENCE_OWNER_ID=evaluator.local
EVIDENCE_INTERVAL_MS=300000
EVIDENCE_LEASE_TTL_MS=360000
EVIDENCE_REBUILD_DAYS=4
PILOT_GUARD_SNAPSHOT_TTL_MS=30000
# Independent protected aggregate diagnostics/export credential and access-audit actor.
PILOT_EVIDENCE_DIAGNOSTICS_TOKEN=
PILOT_EVIDENCE_DIAGNOSTICS_ACTOR_ID=
# Scheduled canaries remain disabled until the authorization record and all runtime gates are reviewed.
TIKDD_CANARY_AUTHORIZED=false
CANARY_DEPLOYMENT=local
CANARY_REGION=canary-global
CANARY_INTERVAL_MS=900000
CANARY_RUN_TIMEOUT_MS=120000
CANARY_LEASE_TTL_MS=130000
CANARY_MEASUREMENT_RETENTION_MS=2592000000
SITE_URL=http://localhost:3000
