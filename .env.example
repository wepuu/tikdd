NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DELIVERY_BASE_URL=http://localhost:4002
API_PORT=4000
DELIVERY_PORT=4002
DELIVERY_PUBLIC_BASE_URL=http://localhost:4002
DATABASE_URL=postgresql://tikdd:tikdd@localhost:5432/tikdd
# Docker Desktop/Hyper-V may reserve the traditional Redis port on Windows.
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379
TASK_TTL_HOURS=24
# Independent bounded cleanup service. Production requires an explicit deployment namespace.
CLEANUP_DEPLOYMENT=local
CLEANUP_INTERVAL_MS=60000
CLEANUP_BATCH_SIZE=100
CLEANUP_TIME_BUDGET_MS=5000
CLEANUP_MAX_BATCHES=24
CLEANUP_STATEMENT_TIMEOUT_MS=2000
CLEANUP_LEASE_TTL_MS=15000
TASK_HARD_RETENTION_MS=86400000
# Required in production. Use a different random key from rollout and delivery secrets.
TASK_ADMISSION_HMAC_KEY_BASE64URL=
ACTIVE_SOURCE_TTL_MS=300000
# Production cannot disable this boundary. With no trusted proxy CIDRs, forwarded headers are
# ignored and the socket peer becomes the anonymous quota identity.
ADMISSION_CONTROL_ENABLED=false
TRUSTED_PROXY_CIDRS=
ADMISSION_CONTROL_POLICY_JSON={"version":"pilot-v1","deployment":"local","region":"global","requestWindowMs":60000,"clientRequestLimit":30,"globalRequestLimit":1000,"clientActiveTaskLimit":3,"globalActiveTaskLimit":100,"taskPermitTtlMs":1800000,"providerDefaultConcurrency":2,"providerLeaseTtlMs":45000,"providerLimits":[]}
ENABLE_MOCK_PROVIDER=true
# Site adapters stay disabled by default. Live tests also require the documented authorization gate.
ENABLE_TWITTERSAVER_PROVIDER=false
ENABLE_DLPANDA_PROVIDER=false
TWITTERSAVER_TERMS_APPROVED=false
DLPANDA_TERMS_APPROVED=false
# Required before a provider may persist delivery candidates. Use a unique 32-byte base64url key.
DELIVERY_ENCRYPTION_KEY_ID=
DELIVERY_ENCRYPTION_KEY_BASE64URL=
WORKER_REGION=global
ROUTE_MAX_ATTEMPTS=4
ROUTE_TIMEOUT_MS=30000
# Production providers require a current affirmative rollout rule. The development bypass is never
# accepted in production. Use a unique random key with at least 32 bytes when rollout is enabled.
PROVIDER_ROLLOUT_ENABLED=false
PROVIDER_ROLLOUT_DEVELOPMENT_BYPASS=false
PROVIDER_ROLLOUT_COHORT_KEY_BASE64URL=
PROVIDER_ROLLOUT_REFRESH_MS=5000
PROVIDER_ROLLOUT_SNAPSHOT_TTL_MS=30000
PROVIDER_ROLLOUT_MAX_STALE_MS=15000
# Dynamic health is opt-in. When enabled, provide a reviewed versioned policy JSON document.
PROVIDER_HEALTH_ENABLED=false
PROVIDER_HEALTH_POLICY_JSON=
PROVIDER_HEALTH_REFRESH_MS=10000
# Optional independent credential for the metadata-only internal diagnostics route.
PROVIDER_DIAGNOSTICS_TOKEN=
# Scheduled canaries remain disabled until the authorization record and all runtime gates are reviewed.
TIKDD_CANARY_AUTHORIZED=false
CANARY_DEPLOYMENT=local
CANARY_REGION=canary-global
CANARY_INTERVAL_MS=900000
CANARY_RUN_TIMEOUT_MS=120000
CANARY_LEASE_TTL_MS=130000
CANARY_MEASUREMENT_RETENTION_MS=2592000000
SITE_URL=http://localhost:3000
