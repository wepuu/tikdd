# Copy to deploy/production.env on the host, keep that file out of Git, and replace every
# example.invalid/placeholder value before a real deployment.
TIKDD_PRODUCTION_ENV_FILE=deploy/production.env.example
TIKDD_COMPOSE_PROJECT=tikdd
TIKDD_GIT_SHA=0000000000000000000000000000000000000000
TIKDD_CONFIGURATION_REVISION=example-not-approved
TIKDD_DEPLOYMENT_ID=tikdd
TIKDD_DEPLOYMENT_STAGE=production
TIKDD_OBSERVATION_CLASS=public
WORKER_REGION=nl
NODE_ENV=production

# Immutable release identities. Replace tags with the full release SHA and record registry digests.
TIKDD_WEB_IMAGE=ghcr.io/example/tikdd-web:git-0000000000000000000000000000000000000000
TIKDD_ADMIN_IMAGE=ghcr.io/example/tikdd-admin:git-0000000000000000000000000000000000000000
TIKDD_SERVICE_IMAGE=ghcr.io/example/tikdd-service:git-0000000000000000000000000000000000000000
TIKDD_NODE_IMAGE=node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
TIKDD_POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
TIKDD_REDIS_IMAGE=redis:7.4.5-alpine@sha256:bb186d083732f669da90be8b0f975a37812b15e913465bb14d845db72a4e3e08
# Optional build-host-only proxy. It is never injected into runtime services or Provider egress.
TIKDD_BUILD_HTTP_PROXY=
TIKDD_BUILD_HTTPS_PROXY=
TIKDD_BUILD_NO_PROXY=localhost,127.0.0.1,::1

# Public origins are build inputs for the Web image and runtime policy for the services.
TIKDD_WEB_PUBLIC_ORIGIN=https://www.example.invalid
TIKDD_API_PUBLIC_ORIGIN=https://api.example.invalid
TIKDD_DELIVERY_PUBLIC_ORIGIN=https://delivery.example.invalid
TIKDD_ADMIN_PUBLIC_ORIGIN=https://admin.example.invalid
SITE_URL=https://www.example.invalid
WEB_ORIGIN=https://www.example.invalid
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_DELIVERY_BASE_URL=https://delivery.example.invalid
DELIVERY_PUBLIC_BASE_URL=https://delivery.example.invalid
DELIVERY_ENCRYPTION_KEY_ID=delivery-v1
ADMIN_ORIGIN=https://admin.example.invalid
ADMIN_API_INTERNAL_ORIGIN=http://127.0.0.1:4100

# Host Nginx reaches only these explicit loopback publications.
TIKDD_NGINX_ORIGIN_PORT=8080
TIKDD_WEB_HOST_PORT=3300
TIKDD_ADMIN_HOST_PORT=3301
TIKDD_API_HOST_PORT=3400
TIKDD_DELIVERY_HOST_PORT=3402
API_PORT=4000
DELIVERY_PORT=4002
ADMIN_API_PORT=4100
ADMIN_API_HOST=127.0.0.1

# Durable host paths and non-secret datastore identifiers.
TIKDD_POSTGRES_DATA_DIR=/var/lib/tikdd/postgres
TIKDD_REDIS_DATA_DIR=/var/lib/tikdd/redis
TIKDD_RUNTIME_DIR=/run/tikdd
TIKDD_SECRETS_DIR=/etc/tikdd/secrets
# Reserve this numeric GID on the host for the root-owned, group-readable secret files. Application
# containers receive it only as a supplemental group; Phase C2 must prove native-Linux readability.
TIKDD_SECRETS_GID=1999
TIKDD_POSTGRES_DB=tikdd
TIKDD_POSTGRES_USER=tikdd
# P0-DR-01 one-shot backup settings. The recipient is a public GPG fingerprint only; keep the
# private restore identity off this host. These values do not schedule backups or choose a destination.
TIKDD_BACKUP_DIR=/var/backups/tikdd/p0-dr-01
TIKDD_BACKUP_POSTGRES_CONTAINER=tikdd-postgres-1
TIKDD_BACKUP_POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
TIKDD_BACKUP_RECIPIENT=
TIKDD_DATABASE_POOL_MAX=4
TIKDD_POSTGRES_MAX_CONNECTIONS=30
TIKDD_POSTGRES_SHARED_BUFFERS=128MB
TIKDD_POSTGRES_WORK_MEM=2MB
TIKDD_POSTGRES_MAINTENANCE_WORK_MEM=32MB
TIKDD_REDIS_MAXMEMORY=128mb

# Explicit subnets make the API's host-ingress gateway peer stable enough for exact proxy trust.
# Recheck host routes immediately before creation and confirm the observed peer during Phase C2.
TIKDD_DATA_SUBNET=172.30.40.0/24
TIKDD_DATA_GATEWAY=172.30.40.1
TIKDD_CALIBRATION_DATA_SUBNET=172.30.43.0/24
TIKDD_CALIBRATION_DATA_GATEWAY=172.30.43.1
TIKDD_HOST_INGRESS_SUBNET=172.30.42.0/24
TIKDD_HOST_INGRESS_GATEWAY=172.30.42.1
TIKDD_PROVIDER_EGRESS_SUBNET=172.30.41.0/24
TIKDD_PROVIDER_EGRESS_GATEWAY=172.30.41.1

# Initial shared-host limits; confirm against measured host and container observations.
TIKDD_WEB_MEMORY_LIMIT=384m
TIKDD_API_MEMORY_LIMIT=320m
TIKDD_WORKER_MEMORY_LIMIT=384m
TIKDD_DELIVERY_MEMORY_LIMIT=320m
TIKDD_ADMIN_API_MEMORY_LIMIT=384m
TIKDD_ADMIN_MEMORY_LIMIT=384m
TIKDD_POSTGRES_MEMORY_LIMIT=512m
TIKDD_REDIS_MEMORY_LIMIT=192m
TIKDD_JOB_MEMORY_LIMIT=384m
TIKDD_LOG_MAX_SIZE=20m
TIKDD_LOG_MAX_FILES=5

# Public-path runtime configuration. This candidate matches the explicit NL host-ingress gateway;
# Phase C2 must confirm the API's actual socket peer before accepting forwarded client identity.
PUBLIC_CONTENT_DEPLOYMENT_ID=tikdd
PUBLIC_CONTENT_STALE_AFTER_MS=900000
PUBLIC_CONTENT_REVALIDATION_TIMEOUT_MS=4000
TASK_TTL_HOURS=24
ACTIVE_SOURCE_TTL_MS=300000
ADMISSION_CONTROL_ENABLED=true
TRUSTED_PROXY_CIDRS=172.30.42.1/32
ADMISSION_CONTROL_POLICY_JSON={"version":"production-foundation-v1","deployment":"tikdd","region":"nl","requestWindowMs":60000,"clientRequestLimit":30,"globalRequestLimit":1000,"clientActiveTaskLimit":3,"globalActiveTaskLimit":100,"taskPermitTtlMs":1800000,"providerDefaultConcurrency":2,"providerLeaseTtlMs":45000,"providerLimits":[]}
RESOLVER_CONCURRENCY=2
ROUTE_MAX_ATTEMPTS=4
ROUTE_TIMEOUT_MS=30000

# Provider and rollout defaults remain fail-closed. This deployment foundation grants no traffic.
ENABLE_MOCK_PROVIDER=false
ENABLE_TWITTERSAVER_PROVIDER=false
ENABLE_DLPANDA_PROVIDER=false
ENABLE_SSSTWITTER_PROVIDER=false
TWITTERSAVER_TERMS_APPROVED=false
DLPANDA_TERMS_APPROVED=false
SSSTWITTER_TERMS_APPROVED=false
SSSTWITTER_DELIVERY_AUDIT_APPROVED=false
# Default-off, exact-canonical-URL diagnostic trace. Never configure a raw URL here.
SSSTWITTER_DIAGNOSTIC_TRACE_ENABLED=false
SSSTWITTER_DIAGNOSTIC_CANONICAL_SHA256=
SSSTWITTER_DIAGNOSTIC_AUTHORIZATION_ID=
SSSTWITTER_DIAGNOSTIC_MAX_INVOCATIONS=2
PROVIDER_ROLLOUT_ENABLED=false
PROVIDER_ROLLOUT_DEVELOPMENT_BYPASS=false
# The isolated calibration profile remains inert unless every value below is explicitly authorized.
TIKDD_CALIBRATION_ENABLE_SSSTWITTER_PROVIDER=false
TIKDD_CALIBRATION_SSSTWITTER_TERMS_APPROVED=false
TIKDD_CALIBRATION_SSSTWITTER_DELIVERY_AUDIT_APPROVED=false
TIKDD_CALIBRATION_ROLLOUT_ENABLED=false
PROVIDER_ROLLOUT_REFRESH_MS=5000
PROVIDER_ROLLOUT_SNAPSHOT_TTL_MS=30000
PROVIDER_ROLLOUT_MAX_STALE_MS=15000
PROVIDER_PILOT_GUARD_REQUIRED=false
PROVIDER_HEALTH_ENABLED=false
PROVIDER_HEALTH_POLICY_JSON={"version":"production-canary-v1","observationWindowMs":900000,"minimumDistinctTasks":2,"thresholds":{"integrity":{"minimumFailures":2,"openRate":1},"accessFriction":{"minimumFailures":2,"openRate":1},"availability":{"minimumFailures":2,"openRate":1}},"baseCooldownMs":30000,"maximumCooldownMs":900000,"recoverySuccesses":2,"snapshotTtlMs":900000,"probeLeaseMs":30000,"aggregationLeaseMs":30000}
PROVIDER_HEALTH_REFRESH_MS=10000

# Admin remains application-authenticated and on demand.
ADMIN_AUTH_MODE=password
ADMIN_DEPLOYMENT_ID=tikdd
ADMIN_REGION=nl
ADMIN_READ_TIMEOUT_MS=2000
ADMIN_FRESHNESS_MS=300000
ADMIN_ROUTE_POLICY_TTL_MS=60000
ADMIN_API_FETCH_TIMEOUT_MS=5000
ADMIN_REFRESH_INTERVAL_MS=30000
TIKDD_ADMIN_BUILD_ID=0000000000000000000000000000000000000000
CLOUDFLARE_TUNNEL_CONFIGURED=false
NGINX_ADMIN_PROXY_CONFIGURED=false

# Manually invoked one-shot workload configuration. No scheduler is defined in Work Item 16.
CLEANUP_DEPLOYMENT=tikdd
CLEANUP_BATCH_SIZE=100
CLEANUP_TIME_BUDGET_MS=5000
CLEANUP_MAX_BATCHES=24
CLEANUP_STATEMENT_TIMEOUT_MS=2000
CLEANUP_LEASE_TTL_MS=15000
TASK_HARD_RETENTION_MS=86400000
EVIDENCE_DEPLOYMENT=tikdd
EVIDENCE_OWNER_ID=owner.tikdd
EVIDENCE_LEASE_TTL_MS=360000
EVIDENCE_REBUILD_DAYS=4
PILOT_GUARD_SNAPSHOT_TTL_MS=30000
PILOT_EVIDENCE_DIAGNOSTICS_ACTOR_ID=owner.tikdd
TIKDD_CANARY_AUTHORIZED=false
TIKDD_SCHEDULED_CANARY_AUTHORIZED=true
CANARY_DEPLOYMENT=tikdd
CANARY_REGION=canary-global
CANARY_INTERVAL_MS=900000
CANARY_RUN_TIMEOUT_MS=120000
CANARY_LEASE_TTL_MS=130000
CANARY_MEASUREMENT_RETENTION_MS=2592000000
TIKDD_INTERNAL_PREFLIGHT_PLAN_PATH=config/x-internal-preflight.json
TIKDD_INTERNAL_PREFLIGHT_SIGNALS_JSON={}

# Work Item 17 host timers invoke only the scheduled Compose wrappers. These values do not grant
# public Worker traffic; the scheduled Canary service uses the isolated canary-global region and
# the explicit scheduledCanaryIds list in config/provider-canaries.json.
TIKDD_OPERATIONAL_DEPLOYMENT=tikdd
