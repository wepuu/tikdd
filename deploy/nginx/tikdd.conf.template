server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__;
    server_name __TIKDD_WEB_HOST__;
    access_log /var/log/nginx/tikdd-web.access.log tikdd_no_query;

    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    if ($tikdd_legacy_home_redirect) { return 301 https://__TIKDD_WEB_HOST__/; }

    location / {
        proxy_pass http://127.0.0.1:__TIKDD_WEB_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__;
    server_name __TIKDD_WEB_APEX_HOST__;

    if ($tikdd_legacy_home_redirect) { return 301 https://__TIKDD_WEB_HOST__/; }
    return 301 https://__TIKDD_WEB_HOST__$request_uri;
}

server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__;
    server_name __TIKDD_GATE_C_HOST__;
    access_log /var/log/nginx/tikdd-gate-c.access.log tikdd_no_query;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    location / {
        proxy_pass http://127.0.0.1:__TIKDD_WEB_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host __TIKDD_WEB_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host __TIKDD_WEB_HOST__;
    }
}

server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__;
    server_name __TIKDD_API_HOST__;
    access_log /var/log/nginx/tikdd-api.access.log tikdd_no_query;

    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:__TIKDD_API_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / { return 404; }
}

server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__;
    server_name __TIKDD_DELIVERY_HOST__;
    access_log /var/log/nginx/tikdd-delivery.access.log tikdd_no_query;

    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    location = /v1/deliveries {
        proxy_pass http://127.0.0.1:__TIKDD_DELIVERY_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location ^~ /d/ {
        proxy_pass http://127.0.0.1:__TIKDD_DELIVERY_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / { return 404; }
}

server {
    listen 127.0.0.1:__TIKDD_NGINX_ORIGIN_PORT__ default_server;
    server_name _;

    return 404;
}
